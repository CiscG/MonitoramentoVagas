{
  "name": "TecOps G — Agendamento e orquestração",
  "nodes": [
    {
      "name": "Agendamento diário",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -350,
        170
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Agendamento semanal",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -350,
        360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "name": "Contexto da execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const previous=$prevNode?.name||'';\nreturn [{json:{run:{kind:previous==='Agendamento semanal'?'weekly':'daily',\n requestedAt:new Date().toISOString(),id:String($execution.id||new Date().toISOString())},profile:{\n locations:['Santa Rosa','Rio Grande do Sul','RS','Remoto'],\n workModes:[],includeRemote:true,allowUnknownLocation:true,\n roleKeywords:[],technologies:[],jobLevels:['Estágio','Júnior','Trainee','Não informada'],\n maxExperienceYears:2,excludeMandatoryExperience:false,\n priorityAreas:['Backend','Full Stack','QA','Desenvolvimento de Jogos','Unity','Game Dev','IoT']\n}}}];"
      }
    },
    {
      "name": "Executar A — coleta",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        800,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_A_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "Executar B — filtragem",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1020,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_B_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "Executar C — validação",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1240,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_C_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "Executar D — classificação",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1460,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_D_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "Executar E — deduplicação",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1680,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_E_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "É execução semanal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3150,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-weekly",
              "leftValue": "={{ $json.run.kind }}",
              "rightValue": "weekly",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "name": "Finalizar execução",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3370,
        410
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const packet=$('Confirmar transação PostgreSQL').first().json;\nreturn [{json:{kind:packet.run.kind,processedAt:new Date().toISOString(),status:'Persistência PostgreSQL confirmada. Espelho GitHub processado.',\n dedupStats:packet.dedupStats||{},revision:packet.committed?.revision}}];"
      }
    },
    {
      "name": "Executar F — relatório",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        3370,
        80
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "CONFIGURE_WORKFLOW_F_ID",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "name": "Enviar relatório semanal por e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        4450,
        80
      ],
      "parameters": {
        "fromEmail": "={{ $env.TECOPS_REPORT_EMAIL_FROM }}",
        "toEmail": "={{ $env.TECOPS_REPORT_EMAIL_TO }}",
        "subject": "={{ $json.reportSubject }}",
        "emailFormat": "html",
        "html": "={{ $json.reportHtml }}",
        "options": {}
      },
      "onError": "stopWorkflow"
    },
    {
      "name": "Merge — contexto e estado",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        390,
        250
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "name": "Ler estado PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        200,
        390
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.payload,p.report_archive,p.revision FROM (SELECT TRUE AS singleton) seed LEFT JOIN tecops_pipeline_state p ON p.singleton=seed.singleton;",
        "options": {}
      }
    },
    {
      "name": "Preparar estado e histórico",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const packet=$input.first().json||{};\nif(!packet.payload||!Array.isArray(packet.payload.vagas)||!Array.isArray(packet.payload.historicoVagas)||\n !Number.isSafeInteger(Number(packet.revision))||!packet.report_archive||\n !Array.isArray(packet.report_archive.reports)){\n throw new Error('PostgreSQL sem estado válido. Execute database/bootstrap-runtime.cjs; não crie histórico vazio.');\n}\nreturn [{json:{run:packet.run,profile:packet.profile,previous:packet.payload,\n reportsArchive:packet.report_archive,pg:{revision:Number(packet.revision)}}}];"
      }
    },
    {
      "name": "Preparar transação PostgreSQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sanitiza diagnósticos antes do commit e do registro público.\nconst p=$input.first().json;\nif(!p.data||!p.run?.id||!Number.isSafeInteger(Number(p.pg?.revision)))\n  throw new Error('Estado/revisão de PostgreSQL ausente, abortando sem publicação.');\nfunction redact(value){\n return String(value??'')\n .replace(/([?&](?:app_key|app_id|api_key|token|access_token|secret|password)=)[^&\\s]+/gi,'$1[REDACTED]')\n .replace(/(Authorization\\s*:\\s*)(?:Bearer|Basic)\\s+\\S+/gi,'$1[REDACTED]')\n .replace(/(\\/api\\/)[A-Za-z0-9_-]{18,}/g,'$1[REDACTED]')\n .slice(0,500);\n}\nconst safeDiagnostics=(Array.isArray(p.diagnostics)?p.diagnostics:[]).map(d=>({\n name:redact(d.name),ok:d.ok===true,statusCode:d.statusCode??null,\n checkedAt:d.checkedAt??null,quantity:d.quantity??0,\n error:d.error?redact(d.error):null\n}));\nconst data={...p.data,diagnosticosFontes:safeDiagnostics};\nreturn [{json:{...p,diagnostics:safeDiagnostics,data,transactionReady:true}}];"
      }
    },
    {
      "name": "Persistir PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2100,
        250
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tecops_commit_pipeline($1::jsonb,$2::bigint,$3::text,$4::text,$5::jsonb) AS committed_result;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.data), Number($json.pg.revision), String($json.run.id), String($json.run.kind), JSON.stringify($json.diagnostics || [])] }}"
        }
      }
    },
    {
      "name": "Confirmar transação PostgreSQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=$input.first().json.committed_result;\nif(result?.committed!==true)throw new Error('Transação PostgreSQL não confirmada: não publicar no GitHub.');\nreturn [{json:{...$('Preparar transação PostgreSQL').first().json,committed:result}}];"
      }
    },
    {
      "name": "Ler versão pública GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2540,
        250
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/CiscG/MonitoramentoVagas/contents/data/vagas.json?ref=main",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "name": "Preparar espelho GitHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2760,
        250
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Confirmar transação PostgreSQL').first().json;\nconst response=$input.first().json||{};\nconst file=response.body?.sha?response.body:response;\nif(!file.sha||typeof file.content!=='string')throw new Error('Espelho GitHub indisponível: dados PostgreSQL preservados. Verifique a publicação.');\nconst next=JSON.stringify(p.data,null,2)+'\\n';\nconst current=Buffer.from(file.content.replace(/\\s/g,''),'base64').toString('utf8');\nreturn [{json:{...p,needsMirror:current!==next,\n publishPayload:{message:'TecOps: atualizar espelho de vagas após commit PostgreSQL',sha:file.sha,\n branch:'main',content:Buffer.from(next,'utf8').toString('base64')}}}];"
      }
    },
    {
      "name": "IF — espelho alterado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2970,
        250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "changed-public",
              "leftValue": "={{ $json.needsMirror }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        }
      }
    },
    {
      "name": "Publicar espelho GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3190,
        90
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://api.github.com/repos/CiscG/MonitoramentoVagas/contents/data/vagas.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.publishPayload }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "name": "Confirmar espelho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3400,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=$input.first().json;\nconst status=Number(result.statusCode||0);\nif(status!==200&&status!==201)throw new Error('PostgreSQL gravado mas espelho GitHub falhou HTTP '+status+'; reexecute para reconciliar.');\nreturn [{json:$('Preparar espelho GitHub').first().json}];"
      }
    },
    {
      "name": "Arquivar relatório PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3640,
        60
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tecops_archive_weekly_report($1::jsonb,$2::text) AS archive_result;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.report), String($json.run.id)] }}"
        }
      }
    },
    {
      "name": "Confirmar relatório PostgreSQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3860,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=$input.first().json.archive_result;\nif(result?.archived!==true)throw new Error('Relatório não arquivado no PostgreSQL.');\nreturn [{json:$('Executar F — relatório').first().json}];"
      }
    }
